# Copy to .env.local for local use; configure Production-only variables in Vercel.
# Leave disabled until database, auth, privacy review, and recovery pilot are ready.
INTAKE_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated Supabase Auth user UUIDs. No public signup.
INTAKE_ALLOWED_USER_IDS=
# Fine-grained token: selected repo only, Contents + Pull requests read/write.
# Do not reuse HOBBES_API_KEY, /oc credentials, or NEXT_PUBLIC_* for secrets.
GITHUB_INTAKE_TOKEN=
GITHUB_REPOSITORY=Gavin-is-trying/Hobbes_
GITHUB_BASE_BRANCH=main
